# Copy to .env and replace both secrets with strong random values.
# Never commit .env or reuse these example values.
EMOTION_INFERENCE_MODE=mock
EMOTION_PRIVACY_SECRET=change-this-to-a-random-secret
EMOTION_API_TOKEN=change-this-to-a-different-random-token

# Optional cloud inference endpoint (leave unset for local/mock mode).
# EMOTION_CLOUD_INFERENCE_URL=http://127.0.0.1:8080/api/infer/image
EMOTION_CLOUD_TIMEOUT_SECONDS=20

# Alert rules
EMOTION_NEGATIVE_THRESHOLD=0.60
EMOTION_ALERT_DURATION_SECONDS=10
EMOTION_ALERT_COOLDOWN_SECONDS=30
EMOTION_RETENTION_DAYS=30
EMOTION_REID_ENABLED=true
